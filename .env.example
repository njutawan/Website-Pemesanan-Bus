# Contoh environment — salin jadi .env lalu sesuaikan.
# docker compose membaca file .env secara otomatis untuk substitusi variabel.
#
# JANGAN commit file .env (sudah di .gitignore & diblokir Nginx).
# Tidak ada password default di proyek ini; buat password acak:
#   openssl rand -base64 24
#
# DEBUG default MATI (fail-closed). Untuk pengembangan lokal jalankan
# perintah dengan DJANGO_DEBUG=1 (lihat `make dev`). Tanpa itu, aplikasi
# berjalan dalam mode produksi dan menolak konfigurasi yang belum aman.

# ---- Database (PostgreSQL MURNI — tidak ada fallback SQLite) ----
# WAJIB diisi. Docker Compose menolak start bila kosong.
POSTGRES_DB=nusantartrans
POSTGRES_USER=nusantar
POSTGRES_PASSWORD=
# Host "db" hanya berlaku DI DALAM Docker Compose.
# Dari host/luar Docker gunakan: localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Produksi dengan TLS: require / verify-full
POSTGRES_SSLMODE=prefer

# ---- Cache (opsional; tanpa ini LocMemCache dipakai) ----
# Produksi WAJIB Redis agar rate limit berlaku lintas worker Gunicorn.
# Di dalam Docker Compose: redis://redis:6379/1
# Di host: redis://127.0.0.1:6379/1
# REDIS_URL=redis://redis:6379/1

# ---- Aplikasi ----
# Kunci rahasia ≥50 karakter. WAJIB di produksi.
# DJANGO_SECRET_KEY=
# 0 = produksi (default), 1 = pengembangan lokal saja.
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=nusantartrans.example,www.nusantartrans.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nusantartrans.example

# Password admin awal (min. 12 karakter). Kosongkan saat DEBUG=1 agar
# seed_data membuat password acak dan menampilkannya SEKALI di log.
# Di produksi (DEBUG=0) variabel ini WAJIB diisi.
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_PASSWORD=
# DJANGO_ADMIN_EMAIL=admin@nusantartrans.example

# Paksa HTTPS di level aplikasi (produksi; redirect utama di Nginx).
# JANGAN di-set saat lokal/preview masih HTTP.
# DJANGO_SSL_REDIRECT=1
# DJANGO_COOKIE_SAMESITE=Lax
# DJANGO_COOKIE_SECURE=1

# ---- Keamanan tambahan (produksi) ----
# Produksi: hanya LAN 192.168.x.x + loopback server yang boleh membuka /admin/.
# Kosong = panel admin terbuka untuk semua IP (hanya mengandalkan login staf).
# JANGAN isi 0.0.0.0/0 — itu sama saja dengan tanpa allowlist.
# Ganti 192.168.0.0/16 bila jaringan kantor Anda memakai rentang lain.
DJANGO_ADMIN_ALLOWED_IPS=127.0.0.1/32,::1/128,192.168.0.0/16
# Origin API lintas-domain yang diizinkan (JANGAN pakai "*").
# DJANGO_CORS_ALLOWED_ORIGINS=
# IP proxy terpercaya untuk X-Forwarded-For (default: 127.0.0.1,::1).
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
# DJANGO_RATELIMIT_ENABLED=1
# DJANGO_CSP_ENABLED=1
# DJANGO_AUDIT_RETENTION_DAYS=180

# ---- Email (reset password admin & notifikasi) ----
# Default pengembangan: console (tercetak di terminal). Produksi WAJIB SMTP,
# jika tidak `core.W021` memperingatkan bahwa reset password tidak terkirim.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=no-reply@nusantartrans.example
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=Nusantara Trans <no-reply@nusantartrans.example>
# DJANGO_SERVER_EMAIL=server@nusantartrans.example
# Tautan reset password kedaluwarsa 1 jam (maks. disarankan 24 jam).
# DJANGO_PASSWORD_RESET_TIMEOUT=3600

# ---- Docker Compose produksi (deploy/docker-compose.prod.yml) ----
# Superuser cluster hanya untuk container db; aplikasi memakai role nt_app
# yang dibuat oleh deploy/db_setup.sql.
# POSTGRES_SUPERUSER=postgres
# POSTGRES_SUPERUSER_PASSWORD=
# POSTGRES_APP_USER=nt_app
# POSTGRES_APP_PASSWORD=

# ---- Pembayaran QRIS online (Pakasir) ----
# Kosongkan PAYMENT_GATEWAY_PROVIDER untuk hanya memakai transfer manual.
# Buat proyek di https://app.pakasir.com, lalu salin Slug, API Key, dan
# Webhook Secret dari halaman detail proyek.
# PAYMENT_GATEWAY_PROVIDER=pakasir
# PAKASIR_SLUG=slug-proyek-anda
# PAKASIR_API_KEY=
# PAKASIR_WEBHOOK_SECRET=
# 1 = proyek sandbox (uang nyata TIDAK masuk); wajib 0 di produksi.
# PAKASIR_SANDBOX=0
# Timeout panggilan API keluar (detik).
# PAKASIR_TIMEOUT_SECONDS=8
#
# Daftarkan Webhook URL di dashboard Pakasir:
#   https://domain-anda.example/pembayaran/pakasir/webhook/
# Endpoint membalas 200 setelah memverifikasi X-Secret DAN mencocokkan
# status ke API Pakasir. Tanpa webhook secret, QRIS online tidak aktif.

# Alias lama (opsional): bila PAKASIR_WEBHOOK_SECRET kosong, nilai ini
# dipakai sebagai webhook secret Pakasir.
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
