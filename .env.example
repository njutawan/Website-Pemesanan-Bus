# Contoh environment — salin jadi .env lalu sesuaikan.
# docker compose membaca file .env secara otomatis untuk substitusi variabel.

# ---- Database (PostgreSQL) ----
# DJANGO_DB_ENGINE=postgres di-set otomatis oleh docker-compose.yml;
# set manual hanya bila menjalankan Django di luar Docker:
#   export DJANGO_DB_ENGINE=postgres
POSTGRES_DB=nusantartrans
POSTGRES_USER=nusantar
POSTGRES_PASSWORD=nusantar
# Host "db" hanya berlaku DI DALAM Docker Compose.
# Dari host/luar Docker gunakan: localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Untuk produksi dengan TLS: require / verify-full
POSTGRES_SSLMODE=prefer

# ---- Cache (opsional; tanpa ini LocMemCache dipakai) ----
# Di dalam Docker Compose: redis://redis:6379/1
# Di host: redis://127.0.0.1:6379/1
# REDIS_URL=redis://redis:6379/1

# ---- Aplikasi ----
DJANGO_ADMIN_PASSWORD=admin123
# DJANGO_SECRET_KEY=ganti-dengan-kunci-acak-panjang
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=nusantartrans.example,www.nusantartrans.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nusantartrans.example
